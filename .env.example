# Server
SERVER_PORT=8080
ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=carhistory
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# SMTP / Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@carhistory.app
EMAIL_FROM_NAME=Car History

# SMS (placeholder - configure per provider)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your_twilio_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890

# File Storage
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_BASE_URL=http://localhost:8080/uploads

# App
APP_BASE_URL=http://localhost:3000
INVITATION_EXPIRY_HOURS=72
PASSWORD_RESET_EXPIRY_MINUTES=30

# Reminder Worker (cron expression)
REMINDER_CRON_SCHEDULE=0 2 * * *

# Admin Bootstrap
# Set ADMIN_EMAIL to auto-promote that user to admin on every startup (idempotent).
# If the user doesn't exist yet, also set ADMIN_PASSWORD to auto-create the account.
ADMIN_EMAIL=admin@carhistory.app
ADMIN_PASSWORD=ChangeMe@123
